{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Volumes/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/Library/Keychains/**"
        },
        {
          "path": "$HOME/Library/LaunchAgents/**"
        },
        {
          "path": "$HOME/.zshrc"
        },
        {
          "path": "$HOME/.zprofile"
        },
        {
          "path": "$HOME/.bashrc"
        },
        {
          "path": "$HOME/.bash_profile"
        },
        {
          "path": "$HOME/.profile"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.crossref.org/*"
        },
        {
          "url": "https://export.arxiv.org/*"
        }
      ]
    }
  ]
}
