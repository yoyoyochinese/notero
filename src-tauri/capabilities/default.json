{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.crossref.org/*" },
        { "url": "https://export.arxiv.org/*" }
      ]
    }
  ]
}
